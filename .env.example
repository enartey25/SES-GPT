# =============================================================
# SES-GPT Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# =============================================================

# PostgreSQL Database (Supabase / RDS / Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sesgpt
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# JWT Security Secret (256-bit secret)
JWT_SECRET=your_super_secret_256_bit_jwt_key_here
JWT_EXPIRATION_MS=86400000

# Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Server Ports
PORT=8080
VITE_PORT=5173

# Frontend Environment Variables (Loaded dynamically by Vite)
VITE_BACKEND_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
